<Project>
  <!--
    Pure build/compiler-defaults half of the SDK-wide/packaging split described in
    CLAUDE.md — no NuGet metadata here, see Shared.Nuget.props for that.
  -->
  <PropertyGroup Label="DefaultBuildContext">
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
  </PropertyGroup>
  <PropertyGroup Label="BuildDefaults">
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;CS0067</NoWarn>
    <Configurations>Debug;Release</Configurations>
    <LangVersion>latestmajor</LangVersion>
    <Platforms>AnyCPU;x86;x64;ARM64</Platforms>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <UseRidGraph>true</UseRidGraph>
  </PropertyGroup>
  <PropertyGroup Label="ReleaseBuildSettings" Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>False</DebugSymbols>
    <DebugType>None</DebugType>
    <DefineConstants/>
  </PropertyGroup>
  <!-- Deterministic, embeddable PDB paths for reproducible CI builds; harmless locally
       since it only activates under GitHub Actions. -->
  <PropertyGroup Label="CiBuildSettings" Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == ''">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <!--
    ── Cluster build configuration ──────────────────────────────────────────
    Cluster inherits from Release: fully optimised, no debug symbols, no
    DEBUG constant. The only addition is the CLUSTER compiler symbol which
    gates cluster-specific code paths.

    Usage in source:
      #if CLUSTER
          // cluster-only code
      #endif

    Package suffix: .Cluster  (e.g. ThunderPropagator.Application.Cluster)
  -->
  <PropertyGroup Label="ClusterBuildSettings" Condition="'$(Configuration)' == 'Cluster'">
    <DebugSymbols>False</DebugSymbols>
    <DebugType>None</DebugType>
    <DefineConstants>CLUSTER</DefineConstants>
    <PackageIdConfigurationSuffix>.Cluster</PackageIdConfigurationSuffix>
  </PropertyGroup>
</Project>
