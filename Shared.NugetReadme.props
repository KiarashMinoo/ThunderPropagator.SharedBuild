<Project>
  <!--
    Unlike the icon, a README is inherently per-consumer content — each repo has its own.
    $(MSBuildThisFileDirectory) here would resolve to wherever THIS file lives once downloaded
    (the consumer's .shared-props\ folder), not the consumer's repo root, so we can't default to
    it the way the icon path does. Each consumer sets $(ThunderPropagatorReadmePath) in its own
    Directory.Build.props (where $(MSBuildThisFileDirectory) correctly means repo root), before
    importing this file. Left unset, no README is packed rather than failing the build.
  -->
  <PropertyGroup Label="PackageReadme">
    <ThunderPropagatorReadmePath Condition="'$(ThunderPropagatorReadmePath)' == ''"></ThunderPropagatorReadmePath>
  </PropertyGroup>

  <!-- Guarded by both an emptiness check and Exists() so an unset or stale path is silently
       skipped instead of failing the pack — see Shared.Nuget.props for the matching
       PackageReadmeFile guard that keeps NuGet from expecting a file that was never packed. -->
  <ItemGroup Label="PackageAssets">
    <!-- The real NU5050 cause on a multi-targeted consumer (net8.0;net9.0;net10.0, per
         Shared.Build.props): `dotnet pack` runs one inner build per TargetFramework, and
         each inner build independently evaluates this ItemGroup and contributes its own
         copy of the None item to the outer, aggregating pack. PackagePath="" + Link="README.md"
         alone does NOT dedupe those N identical contributions — NuGet still sees N entries
         all resolving to the package path "README.md" and fails with NU5050 ("Attempted to
         pack multiple files into the same location(s)"). Confirmed against real CI failures
         on ThunderPropagator.FormatSerializers (3 TFMs => the item was added 3 times).
         The actual fix is to only add the item ONCE, during the single outer/aggregating
         evaluation — which is the one pass where $(TargetFramework) is empty and only the
         plural $(TargetFrameworks) is set. For a consumer that ISN'T multi-targeted at all
         (only ever has $(TargetFramework), never $(TargetFrameworks)), that same condition
         would wrongly suppress the item forever, so it's paired with an
         "isn't multi-targeted" escape hatch: '$(TargetFrameworks)' == ''. Link is kept
         alongside PackagePath="" purely to pin the exact, case-sensitive in-package
         filename (naming on case-sensitive Linux is unaffected); it does not by itself
         solve the duplication. -->
    <None Include="$(ThunderPropagatorReadmePath)"
          Condition="'$(ThunderPropagatorReadmePath)' != '' and Exists('$(ThunderPropagatorReadmePath)') and ('$(TargetFrameworks)' == '' or '$(TargetFramework)' == '')"
          Pack="true"
          PackagePath=""
          Link="README.md"/>
  </ItemGroup>
</Project>
