<Project>
  <!--
    Self-contained icon handling: downloads the shared ThunderPropagator brand image
    next to this file (best-effort, never fails a build) and packs it into every
    consumer's NuGet package, so consumers don't vendor the image themselves.
  -->
  <PropertyGroup>
    <IconName>ThunderPropagator.png</IconName>
    <IconUrl>https://raw.githubusercontent.com/KiarashMinoo/ThunderPropagator.SharedBuild/main/ThunderPropagator.png?cb=$([System.DateTime]::UtcNow.Ticks)</IconUrl>
    <IconPath>$(MSBuildThisFileDirectory)$(IconName)</IconPath>
  </PropertyGroup>

  <!-- Both messages must be evaluated (and thus placed) before Delete runs — Delete itself
       changes what Exists() returns, so a message conditioned on it placed afterwards would
       misreport its own result. -->
  <Target Name="CleanThunderPropagatorIcon" BeforeTargets="Clean">
    <Message Importance="normal" Text="[SharedProps] Deleting $(IconName) icon at $(IconPath) ..." Condition="Exists('$(IconPath)')"/>
    <Message Importance="normal" Text="[SharedProps] No $(IconName) icon present at $(IconPath); nothing to clean." Condition="!Exists('$(IconPath)')"/>
    <Delete Files="$(IconPath)" Condition="Exists('$(IconPath)')" ContinueOnError="WarnAndContinue"/>
  </Target>

  <!-- Runs on both Build and Restore (unlike the dependency-updater script, which is
       Restore-only) because the icon must exist by pack time, and a plain `dotnet build`
       with no prior restore still needs to produce a valid package. -->
  <Target Name="DownloadThunderPropagatorIcon" BeforeTargets="_GenerateRestoreProjectPathWalk;Restore;Build">
    <MakeDir Directories="$(MSBuildThisFileDirectory)" Condition="!Exists('$(MSBuildThisFileDirectory)')"/>
    <Message Importance="normal" Text="[SharedProps] $(IconName) already present at $(IconPath); skipping download." Condition="Exists('$(IconPath)')"/>
    <Message Importance="normal" Text="[SharedProps] Downloading $(IconName) icon from $(IconUrl) (up to 3 attempts, 2s apart) ..." Condition="!Exists('$(IconPath)')"/>
    <!-- A solution restore/build runs multiple projects — and, for multi-targeted ones, several
         per-TargetFramework inner builds — in parallel, and each evaluates this target
         independently. Downloading straight to $(IconPath) let two callers open the same
         destination file for writing at the same time, producing MSB3923 "file in use by
         another process". Download to a temp file unique to this project+TFM first, then
         atomically Move it into place. $(MSBuildProcessId) doesn't help here — a single `dotnet
         build -m` process restores every project in the graph, so all of them share one process
         ID; $(MSBuildProjectName)$(TargetFramework) is what's actually distinct per caller. This
         is the reference implementation of the pattern — every other self-downloading target in
         this repo applies the same fix and points back to this comment. -->
    <DownloadFile DestinationFileName="$(IconName).$(MSBuildProjectName)$(TargetFramework).tmp"
                  SourceUrl="$(IconUrl)"
                  DestinationFolder="$(MSBuildThisFileDirectory)"
                  Condition="!Exists('$(IconPath)')"
                  Retries="3"
                  RetryDelayMilliseconds="2000"
                  ContinueOnError="WarnAndContinue"/>
    <!-- Move does not overwrite an existing destination (throws MSB3677 if one is already
         there), so this is first-writer-wins: only move our temp file into place if nobody
         else's is there yet. Losing that race is harmless — a sibling's copy already won —
         so it's downgraded to a warning instead of failing the build. -->
    <Move SourceFiles="$(MSBuildThisFileDirectory)$(IconName).$(MSBuildProjectName)$(TargetFramework).tmp"
          DestinationFiles="$(IconPath)"
          Condition="Exists('$(MSBuildThisFileDirectory)$(IconName).$(MSBuildProjectName)$(TargetFramework).tmp') and !Exists('$(IconPath)')"
          ContinueOnError="WarnAndContinue"/>
    <Delete Files="$(MSBuildThisFileDirectory)$(IconName).$(MSBuildProjectName)$(TargetFramework).tmp"
            Condition="Exists('$(MSBuildThisFileDirectory)$(IconName).$(MSBuildProjectName)$(TargetFramework).tmp')"
            ContinueOnError="WarnAndContinue"/>
    <Message Importance="high" Text="[SharedProps] Could not download $(IconName) after 3 attempts; continuing without a PackageIcon for this build." Condition="!Exists('$(IconPath)')"/>
  </Target>

  <!-- Condition="Exists(...)" keeps a failed best-effort download from breaking `dotnet pack`
       (Copy/Pack would otherwise fail trying to include a file that was never downloaded).
       Also guarded against NU5050 on a multi-targeted consumer (net8.0;net9.0;net10.0, per
       Shared.Build.props) the same way as Shared.NugetReadme.props: `dotnet pack` evaluates
       this ItemGroup once per inner per-TargetFramework build, and PackagePath="" + Link alone
       does not dedupe those N identical contributions — only adding the item during the single
       outer/aggregating evaluation (where $(TargetFramework) is empty) does. The
       '$(TargetFrameworks)' == '' escape hatch keeps this working for a consumer that isn't
       multi-targeted at all. See Shared.NugetReadme.props for the full writeup — this had the
       same latent bug but hadn't yet hit it in CI the way the readme did. -->
  <ItemGroup Label="PackageAssets">
    <None Include="$(IconPath)"
          Pack="true"
          Link="$(IconName)"
          PackagePath=""
          Condition="Exists('$(IconPath)') and ('$(TargetFrameworks)' == '' or '$(TargetFramework)' == '')"/>
  </ItemGroup>
</Project>
