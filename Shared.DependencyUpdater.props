<Project>
  <!--
    Wires the optional dependency-updater script into a consumer's restore pipeline as a
    report-only, pre-restore check: DownloadScript fetches the script (or reuses a consumer's
    own committed copy under .github/scripts/ — see the path comment below) and runs on both
    Build and Restore so the script is available either way. RunDependencyUpdater is the
    actual check — it runs the script with -Check, which only prints current-vs-latest
    versions and never mutates a tracked file — and is deliberately Restore-only, never on a
    plain Build. Every failure is a warning, so a network hiccup or script error never breaks
    the build.
  -->
  <PropertyGroup>
    <ScriptName>Update-ThunderPropagatorDependencies.ps1</ScriptName>
    <ScriptUrl>https://raw.githubusercontent.com/KiarashMinoo/ThunderPropagator.SharedBuild/main/$(ScriptName)</ScriptUrl>
    <!-- This file is downloaded into <repo>\.shared-props\, so $(MSBuildThisFileDirectory)
         is that folder — go up one level to reach the repo root before .github\scripts\. -->
    <ScriptsPath>$(MSBuildThisFileDirectory)../.github/scripts/</ScriptsPath>
    <ScriptPath>$(ScriptsPath)$(ScriptName)</ScriptPath>
  </PropertyGroup>

  <!-- Both messages must be evaluated (and thus placed) before Delete runs — Delete itself
       changes what Exists() returns, so a message conditioned on it placed afterwards would
       misreport its own result. -->
  <Target Name="CleanScript" BeforeTargets="Clean">
    <Message Importance="normal" Text="[SharedProps] Deleting $(ScriptName) script at $(ScriptPath) ..." Condition="Exists('$(ScriptPath)')"/>
    <Message Importance="normal" Text="[SharedProps] No $(ScriptName) script present at $(ScriptPath); nothing to clean." Condition="!Exists('$(ScriptPath)')"/>
    <Delete Files="$(ScriptPath)" Condition="Exists('$(ScriptPath)')"/>
  </Target>

  <Target Name="DownloadScript" BeforeTargets="_GenerateRestoreProjectPathWalk;Restore;Build">
    <MakeDir Directories="$(ScriptsPath)" Condition="!Exists('$(ScriptsPath)')"/>
    <Message Importance="normal" Text="[SharedProps] $(ScriptName) already present at $(ScriptPath); skipping download." Condition="Exists('$(ScriptPath)')"/>
    <Message Importance="normal" Text="[SharedProps] Downloading $(ScriptName) from $(ScriptUrl) (up to 3 attempts, 2s apart) ..." Condition="!Exists('$(ScriptPath)')"/>
    <!-- Same race as the icon/shared-props downloads: a solution restore/build runs multiple
         projects — and, for multi-targeted ones, several per-TargetFramework inner builds — in
         parallel, and each evaluates this target independently. Downloading straight to
         $(ScriptPath) let two callers open the same destination file for writing at the same
         time, producing MSB3923 "file in use by another process". Download to a temp file
         unique to this project+TFM first, then atomically Move it into place — same fix as
         DownloadSharedProps in Directory.Build.props and DownloadThunderPropagatorIcon in
         Shared.NugetIcon.props; see the comment on the former for the full reasoning, including
         why $(MSBuildProcessId) doesn't give per-caller uniqueness here. -->
    <DownloadFile DestinationFileName="$(ScriptName).$(MSBuildProjectName)$(TargetFramework).tmp"
                  SourceUrl="$(ScriptUrl)"
                  DestinationFolder="$(ScriptsPath)"
                  Condition="!Exists('$(ScriptPath)')"
                  Retries="3"
                  RetryDelayMilliseconds="2000"
                  ContinueOnError="WarnAndContinue"/>
    <!-- Move does not overwrite an existing destination (throws MSB3677 if one is already
         there), so this is first-writer-wins: only move our temp file into place if nobody
         else's is there yet. Losing that race is harmless — a sibling's copy already won —
         so it's downgraded to a warning instead of failing the build. -->
    <Move SourceFiles="$(ScriptsPath)$(ScriptName).$(MSBuildProjectName)$(TargetFramework).tmp"
          DestinationFiles="$(ScriptPath)"
          Condition="Exists('$(ScriptsPath)$(ScriptName).$(MSBuildProjectName)$(TargetFramework).tmp') and !Exists('$(ScriptPath)')"
          ContinueOnError="WarnAndContinue"/>
    <Delete Files="$(ScriptsPath)$(ScriptName).$(MSBuildProjectName)$(TargetFramework).tmp"
            Condition="Exists('$(ScriptsPath)$(ScriptName).$(MSBuildProjectName)$(TargetFramework).tmp')"/>
    <Message Importance="high" Text="[SharedProps] Could not download $(ScriptName) after 3 attempts; skipping the dependency-version check for this run." Condition="!Exists('$(ScriptPath)')"/>
  </Target>

  <Target Name="RunDependencyUpdater" AfterTargets="DownloadScript" BeforeTargets="_GenerateRestoreProjectPathWalk;Restore;Build" Condition="Exists('$(ScriptPath)')">
    <Message Importance="normal" Text="[SharedProps] Checking ThunderPropagator dependency versions via $(ScriptPath) ..."/>
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(ScriptPath)&quot; -Check"
          ContinueOnError="WarnAndContinue"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_DependencyCheckExitCode"/>
    </Exec>
    <Message Importance="normal" Text="[SharedProps] Dependency version check completed; all family packages are up to date or the report above lists what's outdated." Condition="'$(_DependencyCheckExitCode)' == '0'"/>
    <Message Importance="high" Text="[SharedProps] Dependency version check exited with code $(_DependencyCheckExitCode); see the output above for details." Condition="'$(_DependencyCheckExitCode)' != '' and '$(_DependencyCheckExitCode)' != '0'"/>
  </Target>
</Project>
